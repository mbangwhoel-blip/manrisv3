{
    "name": "semar/manris",
    "description": "Sistem Informasi Manajemen Risiko — SEMAR",
    "type": "project",
    "require": {
        "php": ">=8.1",
        "phpoffice/phpword": "^1.4"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "Semar\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Semar\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "vendor/bin/phpunit",
        "test-coverage": "vendor/bin/phpunit --coverage-text"
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true
    }
}
