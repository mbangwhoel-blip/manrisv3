# ===========================================
# .env — Template untuk PRODUCTION
# ===========================================
# LOKASI AMAN (disarankan): taruh .env DI LUAR webroot, contoh:
#   /etc/manrisv2/.env  (Linux)  atau  C:\xampp\manrisv2_config\.env  (XAMPP)
# lalu arahkan aplikasi ke file tsb via environment variable:
#   SetEnv MANRIS_ENV_FILE /etc/manrisv2/.env   (Apache vhost)
#   atau  export MANRIS_ENV_FILE=/etc/manrisv2/.env  (CLI/systemd)
# Jika MANRIS_ENV_FILE tidak diset, aplikasi mencari:
#   1. <parent-dari-webroot>/manrisv2_config/.env
#   2. <app-root>/.env  (fallback — pastikan .htaccess/web server memblokirnya)
# JANGAN commit .env ke git (sudah di .gitignore).
# JANGAN pakai kredensial development (root tanpa password) di production!

# Environment WAJIB production
APP_ENV=production

# Database — gunakan user DB dedicated dengan privilege terbatas (bukan root!),
# password acak minimal 24 karakter. Ganti placeholder di bawah.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=manris_db
DB_USER=manris_app
DB_PASS=GANTI_DENGAN_PASSWORD_KUAT_MIN_24_KARAKTER

# App URL — wajib HTTPS di production
APP_URL=https://domain-anda.com

# Session timeout (detik)
SESSION_LIFETIME=7200

# APP_KEY — kunci HMAC/enkripsi. WAJIB unik per instalasi & rahasia.
# Generate baru dengan: php -r "echo bin2hex(random_bytes(32));"
# JANGAN pakai nilai contoh dari .env development.
APP_KEY=GANTI_DENGAN_KEY_ACAK_64_HEXA

# Secret untuk trigger migrasi via web (migrate.php).
# Kirim via header X-Migration-Key (disarankan — tidak terekam di access log):
#   curl -H "X-Migration-Key: <secret>" https://domain/manrisv2/migrate.php
# ?key=... juga didukung untuk kompatibilitas.
# Generate dengan: php -r "echo bin2hex(random_bytes(32));"
# Kosongkan jika migrasi hanya lewat CLI.
MIGRATION_SECRET=

# Secret untuk trigger cron notifikasi via web (cron_notif.php).
# Kirim via header X-Cron-Key (disarankan):
#   curl -H "X-Cron-Key: <secret>" https://domain/manrisv2/cron_notif.php
# ?key=... juga didukung untuk kompatibilitas.
CRON_SECRET_KEY=

# SMTP untuk notifikasi email (opsional, kosongkan jika tidak dipakai)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=tls
SMTP_USER=
SMTP_PASS=
SMTP_FROM_NAME=Sistem Manajemen Risiko

# Daftar IP proxy terpercaya (pisahkan koma) agar getIPAddress() mempercayai
# header X-Forwarded-For / CF-Connecting-IP. Contoh: "103.21.244.0/22,1.1.1.1"
# HANYA isi jika aplikasi di belakang reverse proxy/WAF (Cloudflare, nginx, dst).
TRUSTED_PROXIES=

# ── Saran Mitigasi AI (Google Gemini) ─────────────────────────
# Fitur "Saran AI" memanggil Google Generative Language API dari sisi SERVER
# (bukan dari browser) lewat endpoint internal /api.php/ai_saran. API key
# tidak pernah terekspos ke klien. Dapatkan key gratis di https://aistudio.google.com
# Kosongkan jika fitur AI tidak dipakai — tombol akan menampilkan pesan error.
GEMINI_API_KEY=
# Model yang dipakai. Default: gemini-1.5-flash (murah & cepat).
# Alternatif terbaru: gemini-2.0-flash, gemini-2.5-flash, gemini-3.8-flash, gemini-1.5-pro, dll.
GEMINI_MODEL=gemini-1.5-flash
# Batas request AI per user per jam (rate-limit sederhana via session).
# Default 20. Naikkan bila perlu; ingat biaya kuota Google.
GEMINI_MAX_REQ_USER_HOUR=20
# Umur cache saran AI per risiko (detik). Default 86400 (24 jam).
# Hasil generate disimpan di tabel ai_saran_cache (jalankan migrasi:
# `php lib/migrate.php run`) agar klik berikutnya untuk risiko yang sama
# tidak memanggil Gemini ulang. Cache otomatis di-invalidate saat risiko
# di-update/dihapus. Set 0 untuk menonaktifkan caching.
GEMINI_CACHE_TTL=86400

# ── Integrasi Bot Telegram (Notifikasi & Chatbot Interaktif) ───
# Buat bot via @BotFather di Telegram untuk mendapatkan token.
TELEGRAM_BOT_TOKEN=
# Chat ID default (akun admin atau ID grup diawali -100) untuk broadcast notifikasi.
TELEGRAM_DEFAULT_CHAT_ID=
# Secret token untuk mengamankan webhook (dikirimkan Telegram via header X-Telegram-Bot-Api-Secret-Token)
TELEGRAM_WEBHOOK_SECRET=

# ── Integrasi WhatsApp Gateway ────────────────────────────────
# Mendukung Fonnte, Wablas, atau Generic Webhook HTTP
WA_GATEWAY_URL=https://api.fonnte.com/send
WA_GATEWAY_TOKEN=
# Nomor WA default untuk pengingat/alert (format 08xxx atau 628xxx)
WA_DEFAULT_NUMBER=
